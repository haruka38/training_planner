<div id="<%= dom_id competition %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">試合名:</strong>
    <%= competition.name %>
  </div>

  <div>
    <strong class="block font-medium mb-1">試合日:</strong>
    <%= competition.competition_date %>
  </div>

  <div>
    <strong class="block font-medium mb-1">OFF曜日①:</strong>
    <%= competition.off_weekday_1_name %>
  </div>

  <div>
    <strong class="block font-medium mb-1">OFF曜日②:</strong>
    <%= competition.off_weekday_2_name %>
  </div>
</div>